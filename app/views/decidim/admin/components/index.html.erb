<% add_decidim_page_title(t("components.title", scope: "decidim.admin")) %>
<%
  allowed_emails = ENV.fetch("STRATIFIED_SORTITIONS_ALLOWED_EMAILS", "").split(",").map { |email| email.strip.downcase }.reject(&:blank?)
  can_see_stratified_sortitions = allowed_emails.include?(current_user&.email.to_s.strip.downcase)
  @components = if can_see_stratified_sortitions
                         @components
                       else
                         @components.reject { |component| component.manifest_name.to_s == "stratified_sortitions" }
                       end
%>

<div class="card">
  <div class="item_show__header">
    <h1 class="item_show__header-title">
      <%= t("components.title", scope: "decidim.admin") %>

      <% if allowed_to?(:create, :component) %>
      <div class="relative">
        <button class="button button__sm button__secondary button--title" data-toggle="add-component-dropdown">
          <%= t "components.index.add", scope: "decidim.admin" %>
          <%= icon "arrow-down-s-line", class: "dropdown-filter-icon" %>
        </button>
        <div class="dropdown-pane" id="add-component-dropdown" data-dropdown data-auto-focus="true" data-close-on-click="true">
          <ul class="vertical menu add-components font-normal">
            <% @manifests.each do |manifest| %>
              <% next if manifest.name.to_s == "stratified_sortitions" && !can_see_stratified_sortitions %>
              <li>
                <%= link_to new_component_path(type: manifest.name), class: manifest.name do %>
                  <%= t("#{manifest.name}.name", scope: "decidim.components") %>
                <% end %>
              </li>
            <% end %>
          </ul>
        </div>
      </div>
      <% end %>
    </h1>
  </div>

  <div class="table-scroll">
    <table class="table-list">
      <thead>
        <th><%= t("name", scope: "decidim.admin.components.index.headers") %></th>
        <th><%= t("type", scope: "decidim.admin.components.index.headers") %></th>
        <%= th_resource_scope_label(t("scope", scope: "decidim.admin.components.index.headers")) %>
        <th><%= t("actions", scope: "decidim.admin.components.index.headers") %></th>
      </thead>

      <tbody>
        <%= render partial: "component", collection: local_assigns.fetch(:components, @components) %>
      </tbody>
    </table>
  </div>
</div>