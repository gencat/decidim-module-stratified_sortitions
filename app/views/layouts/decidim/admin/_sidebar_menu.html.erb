<%
  stratified_sortitions_paths = if defined?(current_participatory_space) && current_participatory_space.respond_to?(:components) && !Decidim::StratifiedSortitions::AllowedEmails.allowed?(current_user&.email)
                                  current_participatory_space.components.filter_map do |component|
                                    manage_component_path(component) if component.manifest_name.to_s == "stratified_sortitions"
                                  end
                                else
                                  []
                                end
  menu_html = sidebar_menu(secondary_root_menu).render

  if stratified_sortitions_paths.any?
    menu_fragment = Nokogiri::HTML::DocumentFragment.parse(menu_html)
    menu_fragment.css("a").each do |link|
      next unless stratified_sortitions_paths.include?(link["href"])

      link.ancestors("li").first&.remove
    end
    menu_html = menu_fragment.to_html.html_safe
  end
%>

<div class="sidebar-menu__container">
  <div class="sidebar-menu">
    <div id="admin-sidebar-menu-settings">
      <div class="hidden md:block">
        <%= menu_html %>
      </div>
      <button data-component="dropdown" data-target="dropdown-menu-sidebar" data-auto-close="true" data-scroll-to-menu="true">
        <span><%= t("menu", scope: "decidim.admin.titles") %></span>
        <%= icon "arrow-down-s-line" %>
        <%= icon "arrow-up-s-line" %>
      </button>

      <ul id="dropdown-menu-sidebar" class="md:hidden" aria-hidden="true">
        <%= menu_html %>
      </ul>
    </div>
  </div>

  <div class="item_show__wrapper">
    <%= admin_tabs(tab_menu_name).render if defined?(has_tab_menu?) && has_tab_menu? %>
    <%= yield %>
  </div>
</div>